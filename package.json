{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "description": "Resource locks for AI agents — in-memory reference implementation",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/protocol packages/core",
    "demo": "ts-node -r tsconfig-paths/register examples/demo.ts",
    "site:dev": "npm run dev --workspace=@relay/site",
    "site:build": "npm run build --workspace=@relay/site"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
